{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DaAwesomePwner/poe-craft-mcp/recipe.schema.json",
  "title": "poe-craft-mcp recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "status", "base", "steps", "outcomes", "salvage", "minutes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["verified", "unverified", "deprecated"] },
    "verified_patch": {
      "description": "Quote it in YAML: an unquoted 3.30 is read as the number 3.3.",
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "budget_div": {
      "description": "Rough per-attempt budget in divines; used only by the list_recipes budget filter.",
      "type": "number",
      "minimum": 0
    },
    "base": { "$ref": "#/$defs/base" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } },
    "salvage": { "$ref": "#/$defs/salvage" },
    "minutes": { "type": "number", "exclusiveMinimum": 0 },
    "notes": { "type": "string" }
  },
  "if": { "required": ["status"], "properties": { "status": { "const": "verified" } } },
  "then": { "required": ["verified_patch"], "properties": { "verified_patch": { "type": "string" } } },
  "$defs": {
    "probability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "ninjaLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "type", "name"],
      "properties": {
        "source": { "const": "ninja" },
        "type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "ilvl_min": { "type": "integer", "minimum": 1, "maximum": 100 },
        "influence": { "type": "string", "minLength": 1 }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lookup": {
          "allOf": [
            { "$ref": "#/$defs/ninjaLookup" },
            { "properties": { "type": { "const": "BaseType" } } }
          ]
        },
        "trade_url": { "type": "string", "minLength": 1 }
      },
      "oneOf": [{ "required": ["lookup"] }, { "required": ["trade_url"] }]
    },
    "material": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "category", "qty"],
          "properties": {
            "source": { "const": "ninja" },
            "category": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "qty": { "type": "number", "exclusiveMinimum": 0 }
          },
          "oneOf": [{ "required": ["name"] }, { "required": ["id"] }]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "chaos", "label"],
          "properties": {
            "source": { "const": "fixed" },
            "chaos": { "type": "number", "minimum": 0 },
            "label": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "chance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_source", "method", "target_mods"],
          "properties": {
            "p_source": { "const": "weights" },
            "method": { "type": "string", "minLength": 1 },
            "target_mods": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "base": { "type": "string" },
            "ilvl": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_source", "value"],
          "properties": {
            "p_source": { "const": "guide" },
            "value": { "$ref": "#/$defs/probability" },
            "source_url": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["p_source", "value"],
          "properties": {
            "p_source": { "const": "user" },
            "value": { "$ref": "#/$defs/probability" }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "materials": { "type": "array", "items": { "$ref": "#/$defs/material" } },
        "repeat_until": { "type": "string", "minLength": 1 },
        "p_success": { "$ref": "#/$defs/chance" }
      },
      "dependentRequired": { "repeat_until": ["p_success"] }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "probability"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "probability": { "$ref": "#/$defs/probability" },
        "trade_url": { "type": "string", "minLength": 1 },
        "fixed_chaos": { "type": "number", "minimum": 0 },
        "use_salvage": { "const": true }
      },
      "oneOf": [
        { "required": ["trade_url"] },
        { "required": ["fixed_chaos"] },
        { "required": ["use_salvage"] }
      ]
    },
    "salvage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trade_url": { "type": "string", "minLength": 1 },
        "lookup": { "$ref": "#/$defs/ninjaLookup" },
        "fixed_chaos": { "type": "number", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["trade_url"] },
        { "required": ["lookup"] },
        { "required": ["fixed_chaos"] }
      ]
    }
  }
}
